# Raw third-party data. Fetch instructions are in the README.
data/raw/
data/cache/

# Trained artefacts. Reproduced by `reproduce.sh`. The model cards and the run
# manifests are tracked, so a reader can check what a model claims without
# rebuilding it -- which needs the directories un-ignored too, or git never
# descends far enough to see the exceptions.
models/**
!models/**/
!models/**/model_card*.md
!models/**/meta.json

# Bulky run output. The JSON/CSV/Markdown summaries and figures are tracked,
# because the deck quotes them and a reader must be able to check a number
# without re-running the study.
results/*.parquet
results/*.log
# per-forecaster timelines behind the ablation replay; regenerated by
# eval/ablation.py and shipped to the web app by eval/export_web.py
results/ablation/

__pycache__/
*.pyc
.pytest_cache/
.venv/

# LaTeX build artefacts. main.pdf is kept -- it is the thing people open.
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.blg
docs/paper/*.bbl
